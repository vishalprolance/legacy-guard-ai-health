# Bank Application Configuration
APP_PATH=C:\Program Files\BankApp\BankApp.exe
APP_TITLE=Bank Application

# Test Credentials (Use test/demo credentials only)
TEST_USERNAME=testuser
TEST_PASSWORD=testpassword

# LLM Configuration (Local hosted)
LLM_API_URL=http://localhost:8000/v1/chat/completions
LLM_API_KEY=your-local-llm-api-key
LLM_MODEL_NAME=gpt-4-turbo

# Alternative LLM configurations (uncomment if using different providers)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Validation Thresholds
SIMILARITY_THRESHOLD=0.85
OCR_CONFIDENCE_THRESHOLD=60

# Tesseract OCR Path (adjust for your system)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Notification Settings (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
EMAIL_SMTP_SERVER=smtp.company.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=alerts@company.com
EMAIL_PASSWORD=email-password
ALERT_RECIPIENTS=admin@company.com,ops@company.com

# Execution Settings
MAX_RETRIES=3
RETRY_DELAY=5
TIMEOUT_SECONDS=30

# Report Settings
REPORT_OUTPUT_DIR=reports
SCREENSHOT_OUTPUT_DIR=screenshots
BASELINE_IMAGES_DIR=baseline

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/health_check.log

# Performance Settings
SCREENSHOT_QUALITY=95
MAX_SCREENSHOT_SIZE=1920x1080

# Security Settings
MASK_SENSITIVE_DATA=true
SECURE_STORAGE=true

# Development Settings
DEBUG_MODE=false
VERBOSE_LOGGING=false
SAVE_INTERMEDIATE_SCREENSHOTS=true